<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<!-- Boot 4.0, а не 4.1, как у портала. Spring Cloud Gateway 5.0.x собран
	     под 4.0.x, и это единственная поддерживаемая пара. Расхождение версий
	     здесь безвредно ровно потому, что это отдельный процесс: с порталом
	     он разговаривает по HTTP, а не по classpath.

	     Реактор с порталом не заводим по той же причине: разные версии Boot
	     в одном реакторе означали бы одну версию на оба модуля. -->
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.0.7</version>
		<relativePath/>
	</parent>

	<groupId>ru.vedal</groupId>
	<artifactId>api-gateway</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>api-gateway</name>
	<description>VEDAL Portal — единая точка входа</description>

	<properties>
		<java.version>25</java.version>
		<spring-cloud.version>2025.1.2</spring-cloud.version>
		<!-- Boot 4.0.7 управляет Netty 4.2.15.Final. Патч 4.2.17.Final
		     закрывает CVE-2026-75595 и сохраняет линию 4.2.x. -->
		<netty.version>4.2.17.Final</netty.version>
		<!-- BouncyCastle приходит транзитивно (nimbus-jose-jwt через oauth2-resource-server);
		     1.81.1 несёт CVE-2026-8763 (CRITICAL), закрыто начиная с 1.85. Три артефакта
		     держатся одной версией — смешивать линии bcprov/bcpkix/bcutil нельзя. -->
		<bouncycastle.version>1.86</bouncycastle.version>
	</properties>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.bouncycastle</groupId>
				<artifactId>bcprov-jdk18on</artifactId>
				<version>${bouncycastle.version}</version>
			</dependency>
			<dependency>
				<groupId>org.bouncycastle</groupId>
				<artifactId>bcpkix-jdk18on</artifactId>
				<version>${bouncycastle.version}</version>
			</dependency>
			<dependency>
				<groupId>org.bouncycastle</groupId>
				<artifactId>bcutil-jdk18on</artifactId>
				<version>${bouncycastle.version}</version>
			</dependency>
			<dependency>
				<groupId>org.springframework.cloud</groupId>
				<artifactId>spring-cloud-dependencies</artifactId>
				<version>${spring-cloud.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<dependencies>
		<dependency>
			<groupId>org.springframework.cloud</groupId>
			<artifactId>spring-cloud-starter-gateway-server-webflux</artifactId>
		</dependency>
		<!-- Проверка токена на периметре. Портал проверяет его ещё раз
		     и сам по себе: шлюз — это фильтр, а не доверенная граница,
		     и запрос, пришедший в портал мимо шлюза, обязан получить отказ. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>

</project>
