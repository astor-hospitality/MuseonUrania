# Настройки локального стека. Скопировать в backend/.env и поправить под себя.
#
# Compose читает backend/.env автоматически. Файл в репозиторий не попадает —
# он в .gitignore, и это единственное место, где живут пароли.
#
# Без .env стек всё равно поднимется: у каждой переменной в compose.yaml есть
# значение по умолчанию, и оно рассчитано на машину разработчика. Файл нужен,
# когда значения надо поменять — и обязателен на сервере.

# ————— база —————
#
# Ролей две, и это не избыточность. VEDAL_DB_USER — владелец схемы: под ним
# накатывает Flyway и работает коннектор Debezium. VEDAL_RUNTIME_USER — роль,
# под которой работает приложение: она меняет данные, но не может изменить
# ни схему, ни права, ни журнал (миграция V16).
#
# Одна роль на оба случая означала бы, что отзыв прав из V15 и V16 приложение
# возвращает себе одной строкой, — то есть что его нет.
VEDAL_DB_NAME=vedal
VEDAL_DB_USER=vedal
VEDAL_DB_PASSWORD=vedal

# Роль рантайма заводится init-скриптом при СОЗДАНИИ кластера. На уже
# существующем томе скрипт не выполнится, и миграция V16 остановит накат
# с требованием завести роль руками:
#   docker exec -it vedal-db psql -U vedal -d vedal \
#     -c "create role vedal_app login password '…'"
VEDAL_RUNTIME_USER=vedal_app
VEDAL_RUNTIME_PASSWORD=vedal-app-local

# ————— объектное хранилище —————
#
# Всё это МОЖНО НЕ ЗАПОЛНЯТЬ. По умолчанию стек кладёт файлы в каталог
# внутри контейнера (vedal.storage.kind=local), и сайт, админка, база
# и события работают целиком. Не появится на сайте только снимок,
# загруженный редактором через админку: каталог наружу не раздаётся.
#
# Ключи нужны тому, кто работает с медиа или документами. Тогда здесь же:
#
#   VEDAL_STORAGE_KIND=s3
#
# Хранилище при этом одно и настоящее: Yandex Object Storage. Своего
# MinIO рядом больше нет. Он говорил на том же протоколе S3, но был
# ВТОРЫМ хранилищем — и файл, положенный локально, в облаке не появлялся.
# «У меня работает, на стенде нет» чаще всего означало ровно это.
#
# Ключи выдаёт сервисный аккаунт в консоли облака: Сервисные аккаунты →
# нужный аккаунт → Создать новый ключ → Статический ключ доступа. Права
# нужны на оба бакета: storage.editor хватает.
#
# Задать kind=s3 и оставить ключи пустыми не выйдет: приложение
# останавливает старт и называет недостающие переменные. Иначе оно
# поднялось бы и упало на первой загрузке файла — отказ увидел бы
# редактор, а не тот, кто разворачивал.
VEDAL_S3_ENDPOINT=https://storage.yandexcloud.net
VEDAL_S3_REGION=ru-central1
VEDAL_S3_ACCESS_KEY=
VEDAL_S3_SECRET_KEY=

# Бакеты. Два, и это требование, а не раскладка:
#   vedal-documents — закрыт полностью. Файл отдаёт контроллер, который
#     проверяет публикацию и пишет обращение в журнал; прямой доступ
#     означал бы выдачу закрытого документа мимо проверки и мимо аудита.
#   vedal-media — публичный на чтение (s3:GetObject), без перечисления.
#
# Заводятся и настраиваются они РУКАМИ, один раз: раньше это делал
# minio-init при каждом подъёме стека, но в облаке бакет — не то, что
# создаётся заново по расписанию. Как именно — docs/PROJECT.md, раздел
# про хранилище.
#
# Своё имя бакета здесь — способ не писать в те, из которых читает живой
# сайт. Работая над медиа, заведите себе vedal-media-dev и укажите его.
VEDAL_S3_BUCKET_DOCUMENTS=vedal-documents
VEDAL_S3_BUCKET_MEDIA=vedal-media

# ————— Keycloak —————
# Учётная запись администратора самого Keycloak, не портала.
VEDAL_KEYCLOAK_ADMIN=admin
VEDAL_KEYCLOAK_ADMIN_PASSWORD=admin-local

# Внешний адрес Keycloak. Он попадает в поле iss выданного токена, и портал
# сверяет его буквально — значит, это ровно тот адрес, по которому за токеном
# ходит браузер. На сервере здесь будет https://id.вашдомен.
VEDAL_KEYCLOAK_URL=http://localhost:8180

# ————— адреса —————
# Адрес, по которому стек виден снаружи. Через него ходят и сайт, и админка.
VEDAL_PUBLIC_URL=http://localhost:8080

# Публичный раздел документов. Временное решение заказчика от 15 сентября:
# витрина скрыта, файлы и админка сохранены. Один рубильник на три места —
# страницу /documents/ на сайте, ответы Ведалины и публичное API портала
# (перечень и выдачу файла). Пока здесь false, GET /api/public/v1/documents
# и /documents/{slug}/file отвечают 404, как и сама страница раздела.
# true — всё оживает без других правок.
VEDAL_PUBLIC_DOCUMENTS_ENABLED=false

# Куда портал пускает кросс-доменные запросы. Через шлюз источник один
# и CORS не участвует; список нужен для прямого обращения к порталу
# и для режима разработки с `npm run dev`.
VEDAL_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000
VEDAL_ADMIN_ORIGINS=http://localhost:8080,http://localhost:3000

# ————— порты на хосте —————
# Меняются, если какой-то из них занят.
VEDAL_GATEWAY_PORT=8080
VEDAL_PORTAL_PORT=8081
VEDAL_KEYCLOAK_PORT=8180

# Порт Keycloak на стенде-продакшне (compose.stand-prod.yaml). На той машине
# 80 и 443 держит чужой сайт, домена ещё нет, и вход открывается по адресу
# с портом. Тогда же VEDAL_KEYCLOAK_URL обязан указывать НАРУЖУ:
#
#   VEDAL_KEYCLOAK_URL=http://51.250.31.97:18180
#
# Значение уезжает и в KC_HOSTNAME, и в NEXT_PUBLIC_OIDC_ISSUER сайта.
# Второй адрес живёт в браузере сотрудника: оставленный localhost означает
# его собственную машину, и вход не работает ни у кого.
VEDAL_KEYCLOAK_HOST_PORT=18180
VEDAL_SITE_PORT=3000
VEDAL_DB_PORT=5434
VEDAL_KAFKA_PORT=9092

VEDAL_CONNECT_PORT=8083

# ————— почта —————
# Пусто — уведомления менеджеру не отправляются. Чужую почту по умолчанию
# не подставляем.
VEDAL_NOTIFICATIONS_MANAGER=

# Транспорт писем. Пусто — письма пишутся в лог и наружу не уходят; это
# рабочее состояние машины разработчика, а не поломка. Задавать три строки
# нужно только вместе.
#
# Сервер — свой на домене: mail.vedal-med.ru, неявный TLS на 465 (порт зашит
# в application.properties). Пароль — пароль самого ящика: «паролей
# приложения» у этого сервера нет. Поэтому ящик заявок держим отдельным
# и ничего, кроме заявок, ему не доверяем.
#
# Пароль сюда вписывается на машине и остаётся на ней. В репозиторий он
# не попадает ни настоящий, ни для примера — репозиторий публичный.
SPRING_MAIL_HOST=
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# Обратный адрес, если он отличается от логина. Почтовый сервер принимает
# письмо только от того ящика, под которым выполнен вход, поэтому пусто —
# берётся логин, и это правильное значение почти всегда.
VEDAL_MAIL_FROM=

# ————— сторож —————
#
# Кому уходят тревоги: сервис лёг, кончается память, кончается место.
# Отправляет тем же ящиком, что и заявки, — своих SMTP-переменных у сторожа
# нет намеренно. А получатель свой: заявки читают продажи, тревоги читает
# тот, кто чинит.
#
# Пусто — сторож пишет только в свой журнал и предупреждает об этом на старте
# и раз в час. На машине разработчика это нормально. В развёрнутой среде —
# нет: там журнал никто не открывает, пока не случится беда, а сторож затем
# и нужен, чтобы про беду узнали раньше.
#
# Подробности и остальные настройки — backend/watchdog/README.md
VEDAL_WATCH_MAIL_TO=

# Адрес сайта наружу — для canonical и og:url в метаданных страниц. Пусто —
# берётся VEDAL_PUBLIC_URL: сегодня сайт и API стоят за одним шлюзом. Задавать
# отдельно нужно, когда API переедет на свой поддомен.
VEDAL_SITE_URL=

# ————— срок хранения персональных данных —————
#
# ПУСТО ЗДЕСЬ — ЭТО НЕ НЕДОДЕЛКА. Срок хранения заказчиком не подтверждён
# (docs/PROJECT.md, технический вопрос 12.2), а обезличивание необратимо:
# ошибись со сроком в меньшую сторону — вычистим клиентскую базу, и взять
# её будет неоткуда, бэкапов тоже нет. Пока числа нет, автоочистки нет:
# при пустом значении портал не создаёт её бины вовсе.
#
# Заполнять эти три строки — отдельное решение, а не шаг разворачивания.
#
# Носителей три, и срок у каждого свой, потому что причина хранить разная:
#   VEDAL_PRIVACY_RETENTION       заявки — пока по обращению не закрыт вопрос
#   VEDAL_PRIVACY_RETENTION_CHAT  разговоры с Ведалиной
#   VEDAL_PRIVACY_RETENTION_MAIL  исходящие письма — ради разбора доставки
#
# Значение — период ISO-8601, а не число дней: P3Y — три года, P18M —
# полтора. Год не равен 365 дням, и писать срок днями значит промахиваться
# на високосные сутки каждые четыре года. Опечатка роняет запуск портала
# при старте, а не молчит до первого ночного прохода.
#
# Что именно стирается у каждого носителя, в каком порядке включать
# и как проверить, что попало под нож, — docs/operations/data_retention.md
VEDAL_PRIVACY_RETENTION=
VEDAL_PRIVACY_RETENTION_CHAT=
VEDAL_PRIVACY_RETENTION_MAIL=

# ————— Яндекс Метрика —————
#
# Номер счётчика. Пусто — счётчика нет: скрипт mc.yandex.ru не загружается,
# плашка про cookie сообщает, а не спрашивает. Это правильное значение для
# машины разработчика и для стенда: их визиты в отчётах боевого сайта —
# испорченная статистика.
#
# Заполняется ТОЛЬКО на боевом сайте и только после ответа заказчика
# на вопрос 12.11 в docs/PROJECT.md: счётчик — это передача данных
# посетителей третьей стороне.
#
# Обе строки заполняются вместе. Номер без источников в политике
# безопасности даёт счётчик, который загрузился и молча не считает;
# источники без номера — открытую дырку в CSP ни за чем.
VEDAL_METRIKA_ID=
VEDAL_ANALYTICS_ORIGINS=
# VEDAL_ANALYTICS_ORIGINS=https://mc.yandex.ru https://mc.yandex.com

# ————— Ведалина / модель —————
# По умолчанию ассистент работает локальным безопасным поиском. Чтобы включить
# модель как слой формулировки ответа поверх согласованных источников, нужны
# две вещи: режим и провайдер.
#
#   VEDAL_ASSISTANT_ENGINE=model        # старое значение yandexgpt = model
#   VEDAL_LLM_PROVIDER=yandex           # или gigachat, или cloudru
#
# Ключи — только выбранного провайдера. Не коммитить и не отправлять
# в Jira/почту открытым текстом.
VEDAL_ASSISTANT_ENGINE=deterministic
VEDAL_LLM_PROVIDER=yandex
VEDAL_LLM_TEMPERATURE=0.2
VEDAL_LLM_MAX_TOKENS=600
VEDAL_LLM_FALLBACK=true

# Провайдер yandex (YandexGPT): docs/operations/yandexgpt_activation.md.
#   VEDAL_YANDEXGPT_MODEL_URI=gpt://<folder_id>/yandexgpt/latest
#   VEDAL_YANDEXGPT_API_KEY=<api-key сервисного аккаунта>
VEDAL_YANDEXGPT_MODEL_URI=
VEDAL_YANDEXGPT_API_KEY=

# Провайдер gigachat (Сбер): docs/operations/gigachat_activation.md.
# Ключ авторизации — кабинет developers.sber.ru → проект → GigaChat API →
# «Ключ авторизации» (это base64 пары client_id:client_secret; можно задать
# и пару по отдельности). Область доступа — по договору: GIGACHAT_API_PERS
# (физлицо), GIGACHAT_API_B2B (предоплата), GIGACHAT_API_CORP (постоплата).
# Двери Сбера подписаны корнем Минцифры, которого нет в JVM: PEM-файл
# кладётся в backend/certs/ до сборки образа (см. README там же) и
# указывается здесь путём внутри контейнера.
#   GIGACHAT_AUTH_KEY=<ключ авторизации>
#   GIGACHAT_CA_BUNDLE=/app/certs/russian_trusted_root_ca.pem
GIGACHAT_AUTH_KEY=
GIGACHAT_CLIENT_ID=
GIGACHAT_CLIENT_SECRET=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat
GIGACHAT_EMBEDDINGS_MODEL=Embeddings
GIGACHAT_EMBEDDINGS_DIMENSION=1024
GIGACHAT_CA_BUNDLE=

# Провайдер cloudru (Cloud.ru Evolution Foundation Models):
# docs/operations/cloudru_models_activation.md. Те же модели GigaChat
# (и открытые модели) за OpenAI-совместимой дверью: ключ статический —
# консоль console.cloud.ru → Evolution Foundation Models → API-ключи, —
# без OAuth, области доступа и корня Минцифры. Один ключ на генерацию
# и эмбеддинги. Размерность эмбеддингов пустая (0) — портал узнаёт её
# по первому ответу модели.
#   CLOUDRU_API_KEY=<API-ключ из консоли>
#   CLOUDRU_MODEL=GigaChat/GigaChat-2-Max   # или GigaChat/GigaChat-3-Pro
CLOUDRU_API_KEY=
CLOUDRU_BASE_URL=https://foundation-models.api.cloud.ru/v1
CLOUDRU_MODEL=GigaChat/GigaChat-2-Max
CLOUDRU_EMBEDDINGS_MODEL=ai-sage/Giga-Embeddings-instruct-480M
CLOUDRU_EMBEDDINGS_DIMENSION=

# ————— Ведалина / поиск по близости (RAG, pgvector) —————
# По умолчанию выключен: корпуса документов у VEDAL пока нет (issue #38),
# индексировать нечего, и каждый вопрос стоил бы вызова эмбеддингов ради
# заведомо пустой выдачи.
#
# Включённый RAG не заменяет поиск по словам, а встаёт перед ним: не нашлось
# в индексе — отвечает прежний поиск. Поэтому включать его можно и до корпуса.
#
# Ключ тот же, что у генерации выбранного провайдера: у Яндекса —
# VEDAL_YANDEXGPT_API_KEY (эмбеддинги живут в том же Foundation Models),
# у Сбера — GIGACHAT_AUTH_KEY, у Cloud.ru — CLOUDRU_API_KEY.
#
# Провайдер индекса свой, VEDAL_RAG_PROVIDER, по умолчанию тот же, что
# VEDAL_LLM_PROVIDER. Размерность векторов у провайдеров разная (256 у Яндекса,
# 1024 у Сбера, у Cloud.ru узнаётся по первому ответу), колонка в базе создана
# под Яндекс, и смена провайдера индекса — это миграция и полная переиндексация
# (docs/operations/gigachat_activation.md, cloudru_models_activation.md).
# Поэтому генерацию можно перевести на Сбер или Cloud.ru, оставив индекс
# на Яндексе.
#
# У Яндекса моделей две, и это не опечатка: документы кодируются одной,
# вопросы — другой, и векторы попадают в одно пространство ровно поэтому.
# У Сбера модель одна — GIGACHAT_EMBEDDINGS_MODEL, у Cloud.ru —
# CLOUDRU_EMBEDDINGS_MODEL.
#
#   VEDAL_RAG_ENABLED=true
#   VEDAL_RAG_PROVIDER=yandex
#   VEDAL_RAG_DOCUMENT_MODEL_URI=emb://<folder_id>/text-search-doc/latest
#   VEDAL_RAG_QUERY_MODEL_URI=emb://<folder_id>/text-search-query/latest
VEDAL_RAG_ENABLED=false
VEDAL_RAG_PROVIDER=
VEDAL_RAG_DOCUMENT_MODEL_URI=
VEDAL_RAG_QUERY_MODEL_URI=
VEDAL_RAG_MAX_DISTANCE=0.45
