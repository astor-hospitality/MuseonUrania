{
  "realm": "vedal",
  "enabled": true,
  "displayName": "VEDAL Portal",
  "loginTheme": "vedal",
  "internationalizationEnabled": true,
  "supportedLocales": [
    "ru"
  ],
  "defaultLocale": "ru",
  "sslRequired": "none",
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": false,
  "verifyEmail": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 3600,
  "ssoSessionMaxLifespan": 36000,
  "roles": {
    "realm": [
      {
        "name": "portal-admin",
        "description": "Всё без ограничений: содержимое сайта, закрытый контур продаж, журнал, справочник сотрудников и уничтожение персональных данных.",
        "composite": true,
        "composites": {
          "realm": [
            "portal-mfa-required"
          ]
        }
      },
      {
        "name": "portal-sales",
        "description": "Закрытый контур продаж: заявки, клиенты, сделки, КП, разговоры и аналитика. Содержимое сайта не правит.",
        "composite": true,
        "composites": {
          "realm": [
            "portal-mfa-required"
          ]
        }
      },
      {
        "name": "portal-production",
        "description": "Содержимое сайта: продукция, категории, новости, документы и снимки. Клиентскую базу не видит."
      },
      {
        "name": "portal-mfa-required",
        "description": "Признак «есть доступ к персональным данным — нужен второй фактор». Прав не даёт: её носителя поток vedal-browser заставляет предъявить TOTP. Выдаётся не человеку, а роли — portal-admin и portal-sales включают её композитом."
      }
    ]
  },
  "clients": [
    {
      "clientId": "vedal-admin-ui",
      "name": "Админка VEDAL Portal",
      "description": "Публичный клиент админки на Next.js. Секрета нет и быть не может: код клиента выполняется в браузере. Поток защищается PKCE.",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://51.250.31.97:18080/*",
        "http://localhost:18080/*",
        "http://localhost:8080/*",
        "http://localhost:3000/*"
      ],
      "webOrigins": [
        "http://51.250.31.97:18080",
        "http://localhost:18080",
        "http://localhost:8080",
        "http://localhost:3000"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "protocolMappers": [
        {
          "name": "vedal-portal-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "vedal-portal",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "vedal-portal",
      "name": "VEDAL Portal (сервер)",
      "description": "Портал токены не выдаёт — он их проверяет. Клиент заведён затем, чтобы его имя можно было положить в aud выданного токена.",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false
    },
    {
      "clientId": "vedal-portal-svc",
      "name": "VEDAL Portal (служебная учётная запись)",
      "description": "Портал ходит этим клиентом в административное API Keycloak за списком сотрудников. Право ровно одно — view-users.",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "${VEDAL_OIDC_SVC_CLIENT_SECRET}"
    }
  ],
  "users": [
    {
      "username": "service-account-vedal-portal-svc",
      "enabled": true,
      "serviceAccountClientId": "vedal-portal-svc",
      "clientRoles": {
        "realm-management": [
          "view-users",
          "manage-users"
        ]
      }
    }
  ],
  "passwordPolicy": "length(12) and notUsername(undefined) and notEmail(undefined) and passwordHistory(3) and specialChars(1) and upperCase(1) and digits(1)",
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 10,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "requiredActions": [
    {
      "alias": "CONFIGURE_TOTP",
      "name": "Configure OTP",
      "providerId": "CONFIGURE_TOTP",
      "enabled": true,
      "defaultAction": false,
      "priority": 10,
      "config": {}
    },
    {
      "alias": "TERMS_AND_CONDITIONS",
      "name": "Terms and Conditions",
      "providerId": "TERMS_AND_CONDITIONS",
      "enabled": false,
      "defaultAction": false,
      "priority": 20,
      "config": {}
    },
    {
      "alias": "UPDATE_PASSWORD",
      "name": "Update Password",
      "providerId": "UPDATE_PASSWORD",
      "enabled": true,
      "defaultAction": false,
      "priority": 30,
      "config": {}
    },
    {
      "alias": "UPDATE_PROFILE",
      "name": "Update Profile",
      "providerId": "UPDATE_PROFILE",
      "enabled": true,
      "defaultAction": false,
      "priority": 40,
      "config": {}
    },
    {
      "alias": "VERIFY_EMAIL",
      "name": "Verify Email",
      "providerId": "VERIFY_EMAIL",
      "enabled": true,
      "defaultAction": false,
      "priority": 50,
      "config": {}
    },
    {
      "alias": "delete_account",
      "name": "Delete Account",
      "providerId": "delete_account",
      "enabled": false,
      "defaultAction": false,
      "priority": 60,
      "config": {}
    },
    {
      "alias": "webauthn-register",
      "name": "Webauthn Register",
      "providerId": "webauthn-register",
      "enabled": true,
      "defaultAction": false,
      "priority": 70,
      "config": {}
    },
    {
      "alias": "webauthn-register-passwordless",
      "name": "Webauthn Register Passwordless",
      "providerId": "webauthn-register-passwordless",
      "enabled": true,
      "defaultAction": false,
      "priority": 80,
      "config": {}
    },
    {
      "alias": "VERIFY_PROFILE",
      "name": "Verify Profile",
      "providerId": "VERIFY_PROFILE",
      "enabled": true,
      "defaultAction": false,
      "priority": 90,
      "config": {}
    },
    {
      "alias": "delete_credential",
      "name": "Delete Credential",
      "providerId": "delete_credential",
      "enabled": true,
      "defaultAction": false,
      "priority": 100,
      "config": {}
    },
    {
      "alias": "update_user_locale",
      "name": "Update User Locale",
      "providerId": "update_user_locale",
      "enabled": true,
      "defaultAction": false,
      "priority": 1000,
      "config": {}
    }
  ],
  "authenticationFlows": [
    {
      "alias": "vedal-browser",
      "description": "Вход в браузере. Отличается от встроенного browser ровно одним: условие второго фактора — не «пользователь уже настроил TOTP», а «у пользователя есть роль portal-mfa-required».",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-cookie",
          "authenticatorFlow": false,
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "autheticatorFlow": false,
          "userSetupAllowed": false
        },
        {
          "authenticator": "auth-spnego",
          "authenticatorFlow": false,
          "requirement": "DISABLED",
          "priority": 20,
          "autheticatorFlow": false,
          "userSetupAllowed": false
        },
        {
          "authenticator": "identity-provider-redirector",
          "authenticatorFlow": false,
          "requirement": "ALTERNATIVE",
          "priority": 25,
          "autheticatorFlow": false,
          "userSetupAllowed": false
        },
        {
          "authenticatorFlow": true,
          "requirement": "ALTERNATIVE",
          "priority": 26,
          "autheticatorFlow": true,
          "flowAlias": "vedal-browser Organization",
          "userSetupAllowed": false
        },
        {
          "authenticatorFlow": true,
          "requirement": "ALTERNATIVE",
          "priority": 30,
          "autheticatorFlow": true,
          "flowAlias": "vedal-browser forms",
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "vedal-browser forms",
      "description": "Формы входа: пароль, затем второй фактор, если он положен по роли.",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-username-password-form",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "autheticatorFlow": false,
          "userSetupAllowed": false
        },
        {
          "authenticatorFlow": true,
          "requirement": "CONDITIONAL",
          "priority": 20,
          "autheticatorFlow": true,
          "flowAlias": "vedal-browser Browser - Conditional OTP",
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "vedal-browser Browser - Conditional OTP",
      "description": "Второй фактор обязателен тому, у кого есть роль portal-mfa-required. Форма OTP стоит REQUIRED: у кого приложение ещё не привязано, тот получит экран привязки, а не пропуск шага.",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticatorConfig": "vedal-mfa-role",
          "authenticator": "conditional-user-role",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "autheticatorFlow": false,
          "userSetupAllowed": false
        },
        {
          "authenticator": "auth-otp-form",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 20,
          "autheticatorFlow": false,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "vedal-browser Organization",
      "description": "Ветка организаций встроенного потока. Оставлена как есть: организации не включены, ветка не срабатывает, а расхождение со встроенным потоком дороже неиспользуемой ветки.",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticatorFlow": true,
          "requirement": "CONDITIONAL",
          "priority": 10,
          "autheticatorFlow": true,
          "flowAlias": "vedal-browser Browser - Conditional Organization",
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "vedal-browser Browser - Conditional Organization",
      "description": "Ветка организаций встроенного потока.",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "conditional-user-configured",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "autheticatorFlow": false,
          "userSetupAllowed": false
        },
        {
          "authenticator": "organization",
          "authenticatorFlow": false,
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "autheticatorFlow": false,
          "userSetupAllowed": false
        }
      ]
    }
  ],
  "authenticatorConfig": [
    {
      "alias": "vedal-mfa-role",
      "config": {
        "condUserRole": "portal-mfa-required",
        "negate": "false"
      }
    }
  ],
  "browserFlow": "vedal-browser"
}
