# Настройки прод-контура на ВМ Cloud.ru. Скопировать в backend/.env на машине
# и заполнить — ЗНАЧЕНИЙ ЗДЕСЬ НЕТ, и это не недоделка: репозиторий публичный.
#
#   cp backend/.env.cloudru.example backend/.env
#   chmod 600 backend/.env
#
# Файл читают три потребителя, и синтаксис у них общий — строго KEY=VALUE,
# без кавычек, без export, без подстановок:
#   - docker compose (backend/.env рядом с compose.yaml подхватывается сам);
#   - systemd-юниты бэкапа и сторожа (EnvironmentFile=);
#   - человек по runbook'у: `set -a; source backend/.env; set +a`.
#
# Какие переменные обязательны и почему — docs/operations/production_move_runbook.md,
# раздел 1 (таблицы 1.1 и 1.2). Здесь тот же список в порядке заполнения.
# Проверка полноты — одной командой, она падает на первой недостающей:
#
#   docker compose -p vedal -f backend/compose.yaml -f backend/compose.prod.yaml \
#     --profile app config --quiet
#
# Секреты генерируются ЗАРАНЕЕ и кладутся в менеджер паролей команды, а не
# придумываются в терминале в ночь переезда. Команда для каждого — рядом.

# ————— домены (§1.1) —————
#
# Три имени, и все три — хосты без схемы: их получает Caddy для vhost'ов
# и политики безопасности. media.* не обслуживается этой машиной (CNAME на
# бакет), но обязан совпадать с хостом из VEDAL_MEDIA_URL ниже — разойдутся,
# и фотографии молча исчезнут (img-src их не разрешит).
VEDAL_DOMAIN=vedal-med.ru
VEDAL_KEYCLOAK_DOMAIN=id.vedal-med.ru
VEDAL_MEDIA_DOMAIN=media.vedal-med.ru

# ————— адреса, как их видит браузер (§1.1) —————
VEDAL_PUBLIC_URL=https://vedal-med.ru
VEDAL_KEYCLOAK_URL=https://id.vedal-med.ru
VEDAL_MEDIA_URL=https://media.vedal-med.ru
# CORS. Только боевой домен: прямого обращения к порталу снаружи нет.
VEDAL_ALLOWED_ORIGINS=https://vedal-med.ru
VEDAL_ADMIN_ORIGINS=https://vedal-med.ru
# КРИТИЧНО ДЛЯ ЗАПУСКА (§1.2). Пусто — robots.txt закрывает сайт от
# индексации целиком. Задать в день выхода на домен.
VEDAL_SITE_URL=https://vedal-med.ru

# ————— база (§1.1) —————
#
# Имя базы и владелец схемы — те же, что на старой машине: иначе это не
# перенос, а новая база. Пароли — НОВЫЕ: они живут внутри docker-сети
# новой машины и старым ничем не обязаны.
VEDAL_DB_NAME=vedal
VEDAL_DB_USER=vedal
# openssl rand -base64 24
VEDAL_DB_PASSWORD=
# Роль рантайма заводит init-скрипт на пустом томе; пароль — новый.
# openssl rand -base64 24
VEDAL_RUNTIME_USER=vedal_app
VEDAL_RUNTIME_PASSWORD=
# База Keycloak в том же кластере (§1.2). Заводится init-скриптом 20-keycloak-db.sh.
VEDAL_KEYCLOAK_DB_NAME=keycloak

# ————— Keycloak (§1.1) —————
#
# Администратор САМОГО Keycloak (realm master), не портала. Новый логин,
# не со стенда. Keycloak 26 заводит по этим переменным временного
# администратора при первом старте на пустой базе; постоянный создаётся
# руками в консоли, временный удаляется — порядок в runbook'е.
VEDAL_KEYCLOAK_ADMIN=
# openssl rand -base64 24
VEDAL_KEYCLOAK_ADMIN_PASSWORD=
# Секрет служебного клиента vedal-portal-svc. Одна переменная уходит и в
# realm при импорте, и в портал — сгенерировать ОДИН раз.
# openssl rand -base64 32
VEDAL_OIDC_SVC_CLIENT_SECRET=

# ————— объектное хранилище Yandex (§1.1, §1.2) —————
#
# Хранилище не переезжает: те же бакеты, тот же сервисный аккаунт
# с ролью storage.editor на vedal-media и vedal-documents. Ключ берётся
# из менеджера паролей команды (или выпускается новый в консоли Yandex
# Cloud: Сервисные аккаунты → Создать статический ключ доступа).
VEDAL_S3_ENDPOINT=https://storage.yandexcloud.net
VEDAL_S3_REGION=ru-central1
VEDAL_S3_ACCESS_KEY=
VEDAL_S3_SECRET_KEY=
VEDAL_S3_BUCKET_MEDIA=vedal-media
VEDAL_S3_BUCKET_DOCUMENTS=vedal-documents
# Копии базы вне машины (docs/operations/backups.md). Тому же ключу нужна
# роль storage.editor на этот бакет — иначе дампы остаются только на ВМ.
VEDAL_BACKUP_S3_BUCKET=vedal-backups

# ————— прокси (§1.2) —————
#
# Дверь /admin: по умолчанию только частные диапазоны, то есть снаружи
# 403 до формы входа. Снять сетевой слой можно только после подтверждённого
# второго фактора у всех (docs/operations/mfa_rollout.md):
#   VEDAL_ADMIN_ALLOW=0.0.0.0/0 ::/0
VEDAL_ADMIN_ALLOW=private_ranges
# Настоящая почта команды: сюда Let's Encrypt напишет, если продление
# сертификата сломается.
VEDAL_ACME_EMAIL=
# Общий edge с соседними проектами (c3ag.ru). Имя сети создаёт
# scripts/bootstrap-cloudru.sh; каталог vhost'ов соседей — там же.
VEDAL_EDGE_NETWORK=edge
VEDAL_EDGE_SITES_DIR=/opt/edge/sites.d
# Порт шлюза на петле 127.0.0.1 — для сторожа и деплоя, снаружи не виден.
VEDAL_GATEWAY_LOOPBACK_PORT=18080

# ————— почта и тревоги (§1.2) —————
#
# Без них сторож пишет тревоги только в журнал, который никто не читает.
# Сервер — mail.vedal-med.ru, порт 465 зашит в приложении; пароль — пароль
# самого ящика заявок (docs/operations/mail_setup.md).
SPRING_MAIL_HOST=
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
VEDAL_MAIL_FROM=
# Адрес менеджера для уведомлений о заявках.
VEDAL_NOTIFICATIONS_MANAGER=
# Получатель тревог сторожа — тот, кто чинит, а не продажи.
VEDAL_WATCH_MAIL_TO=
# Вебхук для тревог healthcheck.sh (docs/operations/monitoring.md):
# адрес, принимающий POST {"text": "..."}. Пусто — только журнал.
VEDAL_ALERT_WEBHOOK=

# ————— витрина —————
#
# Раздел документов: один рубильник на сайт, портал и Ведалину
# (docs/operations/public_feature_switches.md). Решение заказчика
# от 15 сентября — скрыт.
VEDAL_PUBLIC_DOCUMENTS_ENABLED=false

# ————— Яндекс Метрика (§1.2, issue #53) —————
#
# Пусто — счётчика нет, и это законное состояние. Заполняются ТОЛЬКО вместе
# и ТОЛЬКО после ответа заказчика на вопрос 12.11 в docs/PROJECT.md:
#   VEDAL_METRIKA_ID=<номер>
#   VEDAL_ANALYTICS_ORIGINS=https://mc.yandex.ru https://mc.yandex.com
VEDAL_METRIKA_ID=
VEDAL_ANALYTICS_ORIGINS=

# ————— Ведалина / YandexGPT и RAG —————
#
# Значения — те же, что стояли в backend/.env старой ВМ: ключ сервисного
# аккаунта Yandex Cloud с ролью ai.languageModels.user. Без них ассистент
# работает детерминированным поиском — отвечает, но хуже.
VEDAL_ASSISTANT_ENGINE=yandexgpt
VEDAL_YANDEXGPT_MODEL_URI=
VEDAL_YANDEXGPT_API_KEY=
VEDAL_YANDEXGPT_TEMPERATURE=0.2
VEDAL_YANDEXGPT_MAX_TOKENS=600
VEDAL_YANDEXGPT_FALLBACK=true
VEDAL_RAG_ENABLED=false
VEDAL_RAG_DOCUMENT_MODEL_URI=
VEDAL_RAG_QUERY_MODEL_URI=
VEDAL_RAG_MAX_DISTANCE=0.45
VEDAL_SPEECHKIT_API_KEY=

# Распознавание речи (голосовой ввод Ведалины). yandex — SpeechKit по ключу
# выше; cloudru — Whisper (openai/whisper-large-v3) за дверью Cloud.ru
# Foundation Models по CLOUDRU_API_KEY (docs/operations/cloudru_models_activation.md,
# раздел про распознавание). На ВМ Cloud.ru целевое значение — cloudru,
# но без заполненного CLOUDRU_API_KEY с ним портал не поднимется, поэтому
# умолчание здесь — yandex. Синтез речи при любом значении остаётся
# на SpeechKit: у Cloud.ru модели синтеза нет.
VEDAL_STT_PROVIDER=yandex
CLOUDRU_API_KEY=
CLOUDRU_STT_MODEL=openai/whisper-large-v3

# ————— срок хранения персональных данных —————
#
# ПУСТО — автоочистка выключена, срок заказчиком не подтверждён
# (docs/operations/data_retention.md). Заполнение — отдельное решение.
VEDAL_PRIVACY_RETENTION=
VEDAL_PRIVACY_RETENTION_CHAT=
VEDAL_PRIVACY_RETENTION_MAIL=

# ————— бэкап и сторож на машине (systemd) —————
#
# Умолчания верные для этой ВМ; перечислены, чтобы их было видно.
VEDAL_DB_CONTAINER=vedal-db
VEDAL_BACKUP_DIR=/var/backups/vedal
VEDAL_BACKUP_KEEP_DAILY=7
VEDAL_BACKUP_KEEP_WEEKLY=4
VEDAL_HEALTH_URL=http://127.0.0.1:18080
VEDAL_HEALTH_DISK_PERCENT=85
# Сервис backup из compose.prod.yaml не запускается (runbook §3.3);
# переменная нужна только ему и оставлена для полноты.
VEDAL_BACKUP_KEEP_DAYS=7
