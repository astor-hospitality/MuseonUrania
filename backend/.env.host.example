# Настройки для машины с соседом. Копируется на сервер в backend/.env
# и заполняется случайными паролями — значений по умолчанию у секретов
# в compose.host.yaml нет, и без них стек не поднимется. Это сделано нарочно:
# сервер, молча вставший с паролем «vedal», хуже сервера, который не встал.
#
# Пароли не придумывать руками:
#   openssl rand -base64 24
#
# Файл в репозиторий не попадает — он в .gitignore.

# ————— база —————
# Ролей две. VEDAL_DB_USER — владелец схемы, под ним ходит Flyway и Debezium.
# VEDAL_RUNTIME_USER — под ним работает приложение: данные менять может,
# схему, права и журнал — нет (миграции V15 и V16).
VEDAL_DB_NAME=vedal
VEDAL_DB_USER=vedal
VEDAL_DB_PASSWORD=

VEDAL_RUNTIME_USER=vedal_app
VEDAL_RUNTIME_PASSWORD=

# ————— объектное хранилище —————
VEDAL_S3_ACCESS_KEY=vedal
VEDAL_S3_SECRET_KEY=

# ————— Keycloak —————
# Учётная запись администратора самого Keycloak, не портала.
VEDAL_KEYCLOAK_ADMIN=admin
VEDAL_KEYCLOAK_ADMIN_PASSWORD=

# Секрет служебного клиента: им портал ходит в административное API Keycloak
# за списком сотрудников. В realm машины разработчика лежит значение по
# умолчанию; здесь оно задаётся своим.
VEDAL_OIDC_SVC_CLIENT_SECRET=

# ————— адреса —————
#
# ВНИМАНИЕ: это адреса, которые видит БРАУЗЕР, то есть локальные концы
# SSH-туннеля, а не порты на сервере. Адрес Keycloak попадает в поле `iss`
# токена и сверяется буквально, а realm разрешает возврат после входа только
# на localhost:8080 — значит, у браузера должны быть именно эти адреса.
VEDAL_PUBLIC_URL=http://localhost:8080
VEDAL_KEYCLOAK_URL=http://localhost:8180
VEDAL_MEDIA_URL=http://localhost:8080/media

VEDAL_ALLOWED_ORIGINS=http://localhost:8080
VEDAL_ADMIN_ORIGINS=http://localhost:8080

# ————— порты на самом сервере —————
#
# Слушаются только на 127.0.0.1. Менять, если заняты соседом: проверить
#   sudo ss -ltnp | grep -E ':(18080|18180)\b'
VEDAL_GATEWAY_HOST_PORT=18080
VEDAL_KEYCLOAK_HOST_PORT=18180

# ————— почта —————
# Пусто — уведомления менеджеру не отправляются. Чужую почту не подставляем.
VEDAL_NOTIFICATIONS_MANAGER=

# ————— Ведалина / модель —————
# Включать только после передачи ключа безопасным каналом. Режим — model
# (старое yandexgpt принимается), провайдер — yandex, gigachat или cloudru; ключи
# нужны только выбранного. Значения ниже остаются пустыми в примере.
VEDAL_ASSISTANT_ENGINE=deterministic
VEDAL_LLM_PROVIDER=yandex
VEDAL_LLM_TEMPERATURE=0.2
VEDAL_LLM_MAX_TOKENS=600
VEDAL_LLM_FALLBACK=true
# yandex: сервисный аккаунт `vedal-llm` (docs/operations/yandexgpt_activation.md)
VEDAL_YANDEXGPT_MODEL_URI=
VEDAL_YANDEXGPT_API_KEY=
# gigachat: ключ авторизации проекта GigaChat API (docs/operations/gigachat_activation.md)
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat
GIGACHAT_EMBEDDINGS_MODEL=Embeddings
GIGACHAT_EMBEDDINGS_DIMENSION=1024
GIGACHAT_CA_BUNDLE=
# cloudru: API-ключ консоли Cloud.ru, Evolution Foundation Models (docs/operations/cloudru_models_activation.md)
CLOUDRU_API_KEY=
CLOUDRU_MODEL=GigaChat/GigaChat-2-Max
CLOUDRU_EMBEDDINGS_MODEL=ai-sage/Giga-Embeddings-instruct-480M
CLOUDRU_EMBEDDINGS_DIMENSION=
# распознавание речи: yandex (SpeechKit) | cloudru (Whisper, тот же CLOUDRU_API_KEY); синтез — всегда SpeechKit
VEDAL_STT_PROVIDER=yandex
CLOUDRU_STT_MODEL=openai/whisper-large-v3

# ————— Ведалина / озвучивание ответов (TTS) —————
# Чей голос читает ответы: yandex — SpeechKit (ключ VEDAL_SPEECHKIT_API_KEY,
# как было), salute — SaluteSpeech Сбера (docs/operations/salutespeech_activation.md).
# Распознавание речи остаётся на SpeechKit при любом значении.
# Ключ SaluteSpeech — ОТДЕЛЬНЫЙ проект «SaluteSpeech API» в кабинете
# developers.sber.ru и отдельный ключ авторизации, не GIGACHAT_AUTH_KEY;
# область доступа — SALUTE_SPEECH_PERS (физлицо), SALUTE_SPEECH_B2B
# (предоплата), SALUTE_SPEECH_CORP (постоплата). Корень Минцифры тот же,
# что у GigaChat: SALUTE_CA_BUNDLE пустой наследует GIGACHAT_CA_BUNDLE.
# Голос — Nec_24000, Bys_24000, May_24000, Tur_24000, Ost_24000, Pon_24000
# (или _8000); формат — wav16 или pcm16, наружу всегда audio/wav.
VEDAL_TTS_PROVIDER=yandex
SALUTE_AUTH_KEY=
SALUTE_SCOPE=SALUTE_SPEECH_PERS
SALUTE_TTS_VOICE=Nec_24000
SALUTE_TTS_FORMAT=wav16
SALUTE_CA_BUNDLE=

# ————— срок хранения персональных данных —————
#
# Пусто — автоочистки нет, и это осознанно: срок заказчиком не подтверждён
# (issue #47, docs/PROJECT.md 12.2), а обезличивание необратимо. Заполнение
# этих трёх строк — отдельное решение, а не шаг разворачивания сервера.
#
# Значение — период ISO-8601: P3Y — три года. Подробности и порядок
# включения — docs/operations/data_retention.md
VEDAL_PRIVACY_RETENTION=
VEDAL_PRIVACY_RETENTION_CHAT=
VEDAL_PRIVACY_RETENTION_MAIL=

# ————— Ведалина / поиск по близости (RAG, pgvector) —————
# Выключен, пока нет корпуса документов (issue #38). Ключ — тот же, что
# у генерации провайдера. Провайдер индекса свой (по умолчанию тот же, что
# VEDAL_LLM_PROVIDER); его смена — миграция колонки и переиндексация.
# У Яндекса моделей две: документная и вопросная; у Сбера и Cloud.ru одна.
VEDAL_RAG_ENABLED=false
VEDAL_RAG_PROVIDER=
VEDAL_RAG_DOCUMENT_MODEL_URI=
VEDAL_RAG_QUERY_MODEL_URI=
VEDAL_RAG_MAX_DISTANCE=0.45
