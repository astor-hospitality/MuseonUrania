# Обратный прокси развёрнутой среды. Единственный контейнер с портами наружу.
#
# Caddy получает и продлевает сертификаты Let's Encrypt сам — ради этого он
# здесь и стоит. У nginx та же работа делается сертботом и таймером, то есть
# двумя лишними местами, где всё ломается молча и обнаруживается через
# девяносто дней.

{
	# Адрес для писем Let's Encrypt: туда придёт предупреждение, если
	# продление перестанет работать.
	email {$VEDAL_ACME_EMAIL:admin@localhost}
}

# ————— сайт, API и админка —————

{$VEDAL_DOMAIN} {
	encode zstd gzip

	# Лимит тела. Согласован с vedal.storage.max-file-size портала (20 МБ
	# на файл) и с фильтром RequestSize на шлюзе (21 МБ). Меньшее значение
	# здесь уронит загрузку документа раньше приложения, и редактор увидит
	# страницу прокси вместо разбора причины.
	request_body {
		max_size 21MB
	}

	header {
		# Год HSTS с поддоменами. Включать только когда TLS работает
		# на всех поддоменах: откатить это нельзя — браузер запомнил.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"

		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"

		# Содержимое сайта своё, картинки из хранилища, вход в Keycloak.
		#
		# ————— почему unsafe-inline у скриптов —————
		#
		# Здесь раньше стояло «для скриптов его нет, и это главное», и это было
		# правильное намерение с неправильным следствием: Next отдаёт полезную
		# нагрузку гидратации двумя встроенными <script> без src и без nonce
		# (self.__next_f.push(...)). Без script-src они попадали под
		# default-src 'self' и запрещались.
		#
		# Замерено, а не выведено: та же политика на пробной странице
		# со встроенным скриптом — скрипт не выполняется; с добавленным
		# script-src 'self' 'unsafe-inline' — выполняется.
		#
		# Следствие было бы молчаливым и полным: страницы отрисовываются,
		# но не оживают. Ни чата, ни формы заявки, ни админки — сайт выглядит
		# правильным и ничего не делает. Никто не наткнулся только потому,
		# что развёрнутой среды до сих пор нет.
		#
		# Чем платим: инъекция скрипта, если она случится, выполнится.
		# Остальное CSP держит — чужой источник, кадр, база, цель формы.
		#
		# Чем это чинится по-настоящему: nonce на запрос через middleware
		# Next. Тогда script-src становится строгим снова, но nonce уникален
		# на каждый ответ, а значит статическая генерация теряется —
		# тринадцать предсобранных страниц становятся серверными на каждый
		# запрос. Это размен архитектуры, а не строчки, и делается он
		# отдельным решением.
		#
		# Хэши не подходят: полезная нагрузка гидратации несёт содержимое
		# страницы и меняется на каждой пересборке и на каждой правке текста.
		#
		# object-src 'none' — базовая мера, которая здесь ничего не стоит.
		# Без неё <object> и <embed> подпадали под default-src 'self', то есть
		# разрешались со своего источника; на сайте их нет ни одного, так что
		# запрет не может ничего сломать.
		#
		# Честно про проверку: показать разницу измерением не вышло. Пробная
		# страница с <object> и <embed> — на свой источник, на чужой, с типом
		# и без — не поднимает нарушения object-src ни с директивой, ни без неё,
		# при том что контрольная картинка с чужого источника нарушение img-src
		# поднимает исправно. Похоже, современный Chrome плагины не запускает
		# вовсе, и запрещать ему нечего.
		#
		# Директива всё равно оставлена: она входит в базовый набор строгой
		# политики, стоит ноль, и работает там, где поведение движка другое.
		# Но считать её проверенной нельзя — она принята на веру, в отличие
		# от script-src выше.
		#
		# unsafe-inline для стилей — отдельная и прежняя цена CSS-модулей Next.
		#
		# ————— VEDAL_ANALYTICS_ORIGINS —————
		#
		# По умолчанию переменная ПУСТА, и политика остаётся ровно такой,
		# какой была: со счётчиком Метрики она не имеет ничего общего до тех
		# пор, пока счётчик не разрешён явно. Это не осторожность ради
		# осторожности — открытый источник для скриптов стоит дорого, и
		# держать его открытым на площадке без счётчика значит платить
		# ни за что.
		#
		# Заполняется вместе с VEDAL_METRIKA_ID и только вместе с ним:
		#   VEDAL_ANALYTICS_ORIGINS=https://mc.yandex.ru https://mc.yandex.com
		#
		# Четыре директивы, и каждая нужна: tag.js — script-src, пиксель
		# и карта кликов — img-src, отправка целей — connect-src, кадр
		# синхронизации — frame-src. Забыть одну означает счётчик, который
		# загрузился и молча не считает: браузер напишет о нарушении в консоль,
		# страница при этом целая, а в отчётах пусто.
		#
		# frame-src появился здесь же. Раньше кадры подпадали под default-src
		# 'self' — то же самое, что 'self' явно; отдельная директива нужна,
		# чтобы разрешить кадр Метрики, не открывая при этом весь default-src.
		#
		# Разошлись эта переменная и NEXT_PUBLIC_YANDEX_METRIKA_ID — счётчик
		# ставится, но не работает. Обе строки живут в одном месте, рядом,
		# в environment сервисов site и proxy.
		#
		# ————— карта на контактах —————
		#
		# https://yandex.ru и https://yandex.com в frame-src — кадр
		# Яндекс.Карт на странице контактов (issue #74). Записаны прямо,
		# а не переменной, и это разница по существу: счётчик — свойство
		# площадки, у стенда своего номера нет и быть не должно, а карта
		# лежит в коде сайта и одинакова везде. Переменная, которую всё
		# равно заполняют на каждой площадке одним и тем же значением,
		# добавляет не гибкость, а место, где можно забыть, — и забытая
		# она даёт пустой прямоугольник вместо карты без единой ошибки
		# на странице.
		#
		# Только frame-src, и этого достаточно: всё, что грузится внутри
		# кадра, живёт под политикой yandex.ru, а не под нашей. Второй домен
		# нужен на случай, когда Яндекс уводит посетителя из-за границы
		# на .com: адрес перенаправления проверяется той же директивой.
		#
		# Разрешение здесь — не разрешение на загрузку. Кадр создаётся
		# только после согласия в плашке про cookie (frontend/lib/consent.ts),
		# и до согласия браузеру нечего проверять этой строкой.
		#
		# ————— blob: в img-src —————
		#
		# Портреты сотрудников в админке. Дверь портрета закрыта токеном,
		# а браузер, идя по адресу в src, токена не прикладывает, — поэтому
		# байты приезжают запросом с Authorization и превращаются в blob:.
		# Под 'self' такой адрес не подпадает: это отдельная схема, и её надо
		# назвать. Без неё портрет загружается, сохраняется, попадает в журнал
		# и не показывается — молча, без ошибки на экране (9 сентября).
		#
		# Та же строка живёт в frontend/lib/security-headers.ts, и разойтись
		# им нельзя: политики складываются в пересечение, то есть в более
		# строгую из двух.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' {$VEDAL_ANALYTICS_ORIGINS:}; object-src 'none'; img-src 'self' data: blob: https://{$VEDAL_MEDIA_DOMAIN} {$VEDAL_ANALYTICS_ORIGINS:}; style-src 'self' 'unsafe-inline'; font-src 'self' data:; media-src 'self' blob: https://{$VEDAL_MEDIA_DOMAIN}; connect-src 'self' https://{$VEDAL_KEYCLOAK_DOMAIN} {$VEDAL_ANALYTICS_ORIGINS:}; frame-src 'self' https://yandex.ru https://yandex.com {$VEDAL_ANALYTICS_ORIGINS:}; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://{$VEDAL_KEYCLOAK_DOMAIN}"

		# Заголовок сервера ничего не защищает, но и сообщать версию незачем.
		-Server
	}

	# ————— дверь правки —————
	#
	# Админка и её API — единственная дверь, через которую содержимое меняется.
	# Дверь одна — поэтому и правило одно. В этом весь выигрыш от «трёх дверей»:
	# ограничение пишется здесь, а не в девятнадцати контроллерах.
	#
	# Открытый вопрос 12.3 — «закрываем по сети или оставляем за паролем и MFA» —
	# закрыт: **основной барьер — пароль и второй фактор**, он живёт в realm-файле
	# (`backend/keycloak/*/vedal-realm.json`, поток `vedal-browser`) и едет вместе
	# с realm'ом в любую среду. Сетевое ограничение — второй, независимый слой,
	# и оно остаётся там, где прокси наш.
	#
	# Почему не наоборот. Сеть работает только там, где мы держим прокси.
	# На стенде Caddy нет вовсе: админка отдаётся общим nginx рядом с чужими
	# боевыми сайтами, и правило там пришлось бы просить у владельца того
	# nginx. Барьер, который есть в одной среде из двух, — не решение, а
	# случайность раскладки. Второй фактор одинаков везде и никем не забывается:
	# он привязан к роли, а не к учётной записи.
	#
	# Значение по умолчанию всё равно `private_ranges`: сеть отсекает то, что
	# до формы входа даже не доходит, и стоит это ноль. Неверно закрытая дверь
	# ломает работу редактора и это видно за минуту; неверно открытая не ломает
	# ничего и не видна никогда — из двух ошибок выбрана та, которую замечают.
	#
	# Снять сетевой слой (доступ к правке не из офиса и не через VPN) — одна
	# строка в окружении:
	#
	#   VEDAL_ADMIN_ALLOW="0.0.0.0/0 ::/0"
	#
	# Снимать её можно только после того, как второй фактор подтверждён рабочим
	# у всех держателей `portal-admin` и `portal-sales`. До этого она означает
	# пароль редактора против интернета. Порядок и откат — в
	# docs/operations/mfa_rollout.md.
	@admin path /admin /admin/* /api/admin/*
	handle @admin {
		@allowed remote_ip {$VEDAL_ADMIN_ALLOW:private_ranges}
		handle @allowed {
			reverse_proxy api-gateway:8080 {
				header_up X-Forwarded-For {remote_host}
				header_up X-Forwarded-Proto {scheme}
				header_up X-Forwarded-Host {host}
			}
		}
		# 403, а не 404: скрывать наличие админки незачем — её адрес стоит
		# в открытом коде сайта, — а оператору, разбирающему жалобу редактора
		# «не пускает», важно отличить запрет от опечатки в адресе.
		respond "Дверь правки доступна только из доверенной сети." 403
	}

	# ————— всё остальное —————

	reverse_proxy api-gateway:8080 {
		# Настоящий адрес клиента доезжает до портала: без него лимит частоты
		# считает всех посетителей одним, а аудит пишет адрес прокси.
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Host {host}
	}
}

# ————— Keycloak —————
#
# Отдельным именем, а не путём на основном домене: так у него своя cookie
# и свой источник, и сессия провайдера идентичности не смешивается
# с сессией сайта.

{$VEDAL_KEYCLOAK_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	reverse_proxy keycloak:8080 {
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Host {host}
	}
}

# ————— медиа —————
#
# Виртуального хоста здесь нет, и это решение, а не пропуск.
#
# Снимки изделий и иллюстрации новостей отдаёт объектное хранилище прямо
# браузеру. Раньше на этом месте стоял reverse_proxy на minio:9000 — свой
# MinIO в docker-сети. MinIO из стека убран, контейнера с таким именем
# больше не существует, и блок отвечал бы 502 на каждую фотографию.
#
# Проксировать вместо него Object Storage было бы хуже, чем ничего: весь
# трафик картинок пошёл бы через эту машину — ровно то, чего отдельный
# домен и был призван избежать.
#
# Отдельный домен при этом никуда не делся, он просто заводится в облаке:
# бакет называют media.vedal-med.ru и вешают на него CNAME. Содержимое,
# которое кладут редакторы, остаётся на своём источнике и не делит куки
# с доменом сайта — то самое, ради чего домен разводили.
#
# Что теряется — честно: X-Content-Type-Options и Content-Security-Policy
# на самих файлах. S3 отдаёт только те заголовки, что лежат в метаданных
# объекта: Content-Type, Cache-Control и ещё несколько. Произвольные ставить
# нечем. Ослабляет это меньше, чем кажется: главное, что давал отдельный
# домен, — чужой источник для загруженного содержимого — обеспечивает сам
# домен, а не заголовок. Условие одно: Content-Type обязан стоять верный,
# иначе браузер начинает угадывать по содержимому — ровно то, от чего
# защищал nosniff. Портал ставит его при загрузке, mc — по расширению.
#
# В настройках бакета остаётся закрепить:
#   Cache-Control         public, max-age=604800
#   перечисление объектов закрыто — открыт только s3:GetObject
#
# Бакет закрытых документов наружу не выставляется никогда и ни под каким
# доменом: файл оттуда отдаёт портал, проверив публикацию и записав
# обращение в журнал.
#
# VEDAL_MEDIA_DOMAIN остаётся — его требует политика безопасности сайта
# выше по файлу. Значение обязано быть хостом из VEDAL_MEDIA_URL. Разойдутся —
# и фотографии молча пропадут: img-src их не разрешит, страница при этом
# откроется целой.

# ————— соседние проекты на той же ВМ —————
#
# Порты 80 и 443 на машине держит один процесс — этот Caddy. Всё, что
# стоит рядом (c3ag.ru из Astor_Butler_MVP, позже бэкенд Astor), заходит
# через него: свой vhost каждый проект кладёт файлом в /opt/edge/sites.d
# на машине (в контейнер каталог смонтирован compose.prod.yaml), а до
# контейнеров соседа Caddy дотягивается по общей внешней сети `edge`.
#
# Каталог живёт на машине, а не в этом репозитории, и это разница по
# существу: чужой vhost правит тот, кто держит чужой сайт, и правит у себя,
# не открывая pull request сюда. Образец и правила — sites.d/*.example
# рядом с этим файлом и docs/operations/cloudru_migration_runbook.md.
#
# Глобальный блок и заголовки выше на соседей не распространяются: у Caddy
# каждый блок хоста — свой, и CSP, HSTS, дверь /admin остаются ровно
# у {$VEDAL_DOMAIN}. Что сосед ставит себе — его дело и его файл.
#
# Пустой каталог — не ошибка: маске без совпадений Caddy не возражает.
import /etc/caddy/sites.d/*.caddy
